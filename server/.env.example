# Required ---------------------------------------------------------------

# Tokens the extension uses to call this server (comma-separated, >= 24 chars each).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
LKOB_ACCESS_TOKENS=

# LegendKeeper API keys, one per project (Project Settings -> Developers -> API Keys).
# Requires the project owner to be on a paid plan. MEMBER role is enough to import.
LK_API_KEYS=

# Recommended ------------------------------------------------------------

# Public URL of this server; used to build token image URLs.
LKOB_PUBLIC_URL=https://lk-to-owlbear.example.com

# Where the extension is hosted (CORS). Leave empty to allow any origin;
# the access token is still required either way.
LKOB_ALLOWED_ORIGINS=https://your-extension-host.example.com

# Optional ---------------------------------------------------------------

# PORT=8787
# HOST=0.0.0.0
# Token hosting: "on" stores finished tokens in LKOB_TOKEN_DIR; "off" makes the
# extension use Owlbear storage instead.
# LKOB_TOKEN_HOSTING=on
# LKOB_TOKEN_DIR=./data/tokens
# LKOB_TOKEN_STORE_MAX_MB=1024
# LKOB_MAX_SOURCE_IMAGE_MB=30
# LKOB_RATE_LIMIT_PER_MINUTE=240
# Restrict image downloads to LegendKeeper's asset host(s) once you know them,
# e.g. the host part of an image URL from your project (subdomains included).
# LK_ASSET_HOSTS=
